{
  "name": "tokos-data",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone onchain rates intelligence platform.",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --parallel --filter @tokos-data/api --filter @tokos-data/worker --filter @tokos-data/web dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:unit": "pnpm --filter @tokos-data/analytics test",
    "test:e2e": "pnpm --filter @tokos-data/web test:e2e",
    "db:migrate": "pnpm --filter @tokos-data/db migrate",
    "db:refresh-views": "pnpm --filter @tokos-data/db refresh-views",
    "ingest:once": "pnpm --filter @tokos-data/worker ingest:once",
    "start:railway:full": "node scripts/start-railway-full.mjs",
    "smoke:core": "node scripts/core-smoke.mjs",
    "build:packages": "pnpm --filter \"./packages/**\" -r build"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.7.0",
    "eslint": "^9.35.0",
    "tsx": "^4.20.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^4.0.0"
  }
}
